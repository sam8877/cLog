{
  "name": "clog-blog",
  "version": "1.0.0",
  "private": true,
  "description": "cLog · 基于 Cloudflare Workers + D1 的单用户博客系统",
  "scripts": {
    "dev": "wrangler dev --local --var DEMO_SEED:1",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create jingsilu-db",
    "db:init:local": "wrangler d1 execute jingsilu-db --local --file=src/database/schema.sql",
    "db:init:remote": "wrangler d1 execute jingsilu-db --remote --file=src/database/schema.sql",
    "test:api": "node test/api.test.js",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "highlight.js": "^11.10.0",
    "hono": "^4.6.5",
    "marked": "^15.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "@playwright/test": "^1.62.1",
    "typescript": "^5.6.3",
    "wrangler": "^3.91.0"
  }
}
